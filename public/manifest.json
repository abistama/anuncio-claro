{
  "manifest_version": 3,
  "name": "Anuncio Claro",
  "version": "0.3.0",
  "description": "Comprueba si a un anuncio de alquiler le faltan los datos obligatorios del artículo 20 del RDL 29/2026 y muestra una ficha clara.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.idealista.com/*",
    "*://*.fotocasa.es/*",
    "*://*.habitaclia.com/*",
    "*://*.pisos.com/*",
    "*://*.yaencontre.com/*",
    "*://*.milanuncios.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Anuncio Claro",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.idealista.com/inmueble/*",
        "*://*.idealista.com/*/inmueble/*",
        "*://*.idealista.com/alquiler-habitacion/*",
        "*://*.idealista.com/*/alquiler-habitacion/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.fotocasa.es/*",
        "*://*.habitaclia.com/*",
        "*://*.pisos.com/*",
        "*://*.yaencontre.com/*",
        "*://*.milanuncios.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
